
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Buku</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <nav>
            <a href="/">Beranda</a>
            <a href="/about">Tentang</a>
            <a href="/katalog">Katalog Buku</a>
            <a href="/tambah">Tambah Buku</a>
        </nav>
    </header>

    <main class="konten form-container">
        <p class="label">KOLEKSI BARU</p>
        <h1>Tambah Buku</h1>
        <p>Isi informasi buku yang ingin ditambahkan.</p>

        <form action="/tambah" method="POST">
            <label for="judul">Judul Buku</label>
            <input
                type="text"
                id="judul"
                name="judul"
                placeholder="Masukkan judul buku"
                required
            >

            <label for="penulis">Nama Penulis</label>
            <input
                type="text"
                id="penulis"
                name="penulis"
                placeholder="Masukkan nama penulis"
                required
            >

            <label for="tahun">Tahun Terbit</label>
            <input
                type="number"
                id="tahun"
                name="tahun"
                min="1000"
                max="2026"
                placeholder="Contoh: 2024"
                required
            >

            <label for="kategori">Kategori Buku</label>
            <select id="kategori" name="kategori" required>
                <option value="">Pilih kategori</option>
                <option value="Novel">Novel</option>
                <option value="Sejarah">Sejarah</option>
                <option value="Pendidikan">Pendidikan</option>
                <option value="Pengembangan Diri">Pengembangan Diri</option>
            </select>

            <button type="submit" class="tombol">Simpan Buku</button>
        </form>
    </main>

    <footer>
        <p>&copy; 2026 Katalog Perpustakaan</p>
    </footer>
</body>
</html>
